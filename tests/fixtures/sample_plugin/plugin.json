{
  "id": "sample-extractor",
  "name": "Sample Extractor Plugin",
  "version": "1.0.0",
  "author": "StreamKeep SDK",
  "description": "Demonstrates extractor, post-process, and upload adapter contracts.",
  "manifest_version": 2,
  "min_app_version": "4.0.0",
  "enabled": true,
  "trusted": false,
  "adapters": [
    {
      "type": "extractor",
      "entrypoint": "SampleExtractor",
      "interface_version": 1,
      "permissions": ["network"],
      "dependencies": [],
      "timeout_seconds": 5
    },
    {
      "type": "postprocess",
      "entrypoint": "SamplePostProcessor",
      "interface_version": 1,
      "permissions": ["filesystem_read"],
      "dependencies": [],
      "timeout_seconds": 5
    },
    {
      "type": "upload",
      "entrypoint": "SampleUploader",
      "interface_version": 1,
      "permissions": ["network"],
      "dependencies": [],
      "timeout_seconds": 5
    }
  ]
}
